# Copy to .env and fill in
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (error: "must include the anthropic-workspace-id header").
# Console -> Settings -> Workspaces -> copy the workspace ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=

# Dev: SQLite. Production / full corpus: PostgreSQL + pgvector, e.g.
# DATABASE_URL=postgresql+psycopg://nyay:PASSWORD@127.0.0.1:5432/nyay
DATABASE_URL=sqlite:///./nyay.db

# Model tiers - bulk kaam sasta model, final reasoning bada model
MODEL_BULK=claude-haiku-5-5
MODEL_SMART=claude-opus-5-5

UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000

# WhatsApp OTP login (abwpl.com)
WHATSAPP_OTP_URL=https://abwpl.com/api/public/otp
WHATSAPP_OTP_API_KEY=
# DEV ONLY - accepts code 123456 without sending WhatsApp. Must be false in production.
OTP_DEV_BYPASS=false

# WhatsApp notifications (same abwpl key). Template must be approved and take 2 parameters:
#   {{1}} = recipient name, {{2}} = update text. List yours: GET /api/admin/whatsapp/templates (platform admin).
# Empty = in-app notifications only.
WHATSAPP_NOTIFY_TEMPLATE=
APP_URL=http://localhost:3000

# Long random string; keep secret. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_DAYS=7

# 10-digit numbers (comma-separated) that can approve Bar / student verifications
PLATFORM_ADMIN_PHONES=
# Admin emails (only count once that account has a password)
PLATFORM_ADMIN_EMAILS=

# Hybrid RAG embeddings (EMBED_DIM must match EMBED_MODEL)
EMBED_MODEL=minishlab/potion-multilingual-128M
EMBED_DIM=256

# Research "Deep analysis" cost controls
# Empty = MODEL_SMART (Opus). claude-sonnet-5-5 costs about half.
MODEL_DEEP_RESEARCH=
DEEP_RESEARCH_EFFORT=low
RESEARCH_SOURCES=5
RESEARCH_PASSAGES_TO_AI=5
RESEARCH_ANSWER_WORDS=300
